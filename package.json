{
  "name": "lightbridge",
  "version": "0.1.1",
  "description": "LightBridge — Pro DJ Link (XDJ-AZ) to Wolfmix via OS2L. Universal desktop app (macOS + Windows).",
  "author": "LightBridge",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "electron-store": "12.0.0",
    "electron-updater": "^6.8.11",
    "prolink-connect": "0.11.0"
  },
  "overrides": {
    "better-sqlite3": "13.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
